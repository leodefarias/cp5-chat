rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function sharesPeer(otherUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/peers/$(pairId(request.auth.uid, otherUid)));
    }

    function validPolicy(policy) {
      return policy in [
        'all_group_messages',
        'mentioned_members',
        'direct_messages_only',
        'disabled'
      ];
    }

    function validDevice() {
      return request.resource.data.keys().hasOnly(['token', 'provider', 'platform', 'enabled', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() < 4096
        && request.resource.data.provider in ['fcm', 'expo']
        && request.resource.data.platform in ['ios', 'android', 'web']
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is number;
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'photoUrl'])
        && request.resource.data.name is string
        && request.resource.data.photoUrl is string;
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || sharesPeer(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phoneNumber is string
        && request.resource.data.birthDate is string
        && request.resource.data.photoUrl is string
        && request.resource.data.createdAt is number;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phoneNumber', 'birthDate', 'photoUrl']);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validDevice();
        allow delete: if isSelf(uid);
      }
    }

    match /directConversations/{conversationId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/directConversations/$(conversationId))
        || request.auth.uid in resource.data.participantIds
      );
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt', 'type'])
        && request.resource.data.type == 'direct'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && conversationId == pairId(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function validGroupShape() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.photoUrl is string
          && request.resource.data.ownerId is string
          && request.resource.data.memberIds is list
          && request.resource.data.memberLimit is int
          && request.resource.data.memberLimit >= 2
          && request.resource.data.memberIds.size() >= 2
          && request.resource.data.memberIds.size() <= request.resource.data.memberLimit
          && request.resource.data.ownerId in request.resource.data.memberIds
          && validPolicy(request.resource.data.notificationPolicy)
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
      }

      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/groups/$(groupId))
        || request.auth.uid in resource.data.memberIds
      );
      allow list: if isMember();
      allow create: if signedIn()
        && validGroupShape()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isOwner()
        && validGroupShape()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberLimit >= resource.data.memberIds.size();
      allow delete: if isOwner();
    }

    match /peers/{pairId} {
      function sameParticipants() {
        return request.resource.data.participantIds == resource.data.participantIds;
      }

      function directAllowsCreate() {
        return exists(/databases/$(database)/documents/directConversations/$(pairId))
          && request.auth.uid in get(/databases/$(database)/documents/directConversations/$(pairId)).data.participantIds
          && request.resource.data.participantIds[0] in get(/databases/$(database)/documents/directConversations/$(pairId)).data.participantIds
          && request.resource.data.participantIds[1] in get(/databases/$(database)/documents/directConversations/$(pairId)).data.participantIds;
      }

      function groupAllows(groupId) {
        return get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
          && request.resource.data.participantIds[0] in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.participantIds[1] in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/peers/$(pairId))
        || request.auth.uid in resource.data.participantIds
      );
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && pairId == pairId(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && request.resource.data.sources is list
        && request.resource.data.managedBy is list
        && (directAllowsCreate() || (request.resource.data.groupId is string && groupAllows(request.resource.data.groupId)));
      allow update: if signedIn()
        && sameParticipants()
        && (
          request.auth.uid in resource.data.managedBy
          || (
            request.resource.data.groupId is string
            && ('group:' + request.resource.data.groupId) in resource.data.sources
            && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid
          )
          || (
            request.resource.data.groupId is string
            && groupAllows(request.resource.data.groupId)
          )
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.managedBy;
    }

    match /notificationDeliveries/{messageId} {
      allow read, write: if false;
    }
  }
}
